# Application

APP_NAME=AlphaMind
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alphamind

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/alphamind

# Redis

REDIS_HOST=redis
REDIS_PORT=6379

REDIS_URL=redis://redis:6379/0


# Qdrant

QDRANT_HOST=qdrant
QDRANT_PORT=6333

QDRANT_URL=http://qdrant:6333

# JWT

JWT_SECRET=CHANGE_ME

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI

OPENAI_API_KEY=your_openai_api_key

# LangSmith (Optional)

LANGCHAIN_TRACING_V2=false

LANGCHAIN_API_KEY=

LANGCHAIN_PROJECT=alphamind

# Logging

LOG_LEVEL=INFO

# CORS

BACKEND_CORS_ORIGINS=http://localhost:3000