# Application

APP_NAME=AlphaMind
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alphamind

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/alphamind

# Redis

REDIS_HOST=redis
REDIS_PORT=6379

REDIS_URL=redis://redis:6379/0


# Qdrant

QDRANT_HOST=qdrant
QDRANT_PORT=6333

QDRANT_URL=http://qdrant:6333

# Object storage (MinIO in dev/docker-compose -- point at a real AWS S3
# or Cloudflare R2 endpoint in staging/production instead, no code
# change needed, see shared/storage.py)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_DOCUMENTS=research-documents

# JWT

JWT_SECRET=CHANGE_ME

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# Email/SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@alphamind.local
SMTP_USE_TLS=false

# LLM providers (ai-service) -- only the one matching LLM_DEFAULT_PROVIDER
# is required to run analyses; the other three can stay blank. See
# services/ai-service/config.py for the tier -> model mapping per provider.
LLM_DEFAULT_PROVIDER=mistral
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
MISTRAL_API_KEY=your_mistral_api_key
# Optional: teammates' own Mistral keys, pooled for real throughput
# multiplication (round-robin across whichever of these 3 are
# actually set -- leave blank until a teammate has generated theirs,
# see ai/llm/mistral_provider.py). Not required for the app to run
# with just MISTRAL_API_KEY above.
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_API_KEY_4=
MISTRAL_API_KEY_5=

# External data providers (ai-service) -- all optional; agents degrade
# gracefully (thin evidence, not a crash) if a given one is unset. See
# ai/providers/*.py's module docstrings for what each one is used for.
SEC_EDGAR_USER_AGENT="Your Company Name AdminContact@yourdomain.com"
FRED_API_KEY=
NEWSAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TAVILY_API_KEY=

# LangSmith (Optional)

LANGCHAIN_TRACING_V2=false

LANGCHAIN_API_KEY=

LANGCHAIN_PROJECT=alphamind

# Logging

LOG_LEVEL=INFO

# CORS

BACKEND_CORS_ORIGINS=http://localhost:3000