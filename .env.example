# AlphaMind environment template.
#
# Copy to .env.docker for docker compose and fill in the secrets:
#   cp .env.example .env.docker
#   make up            # = docker compose --env-file .env.docker up --build
# .env.docker is never committed. docker compose reads the values below
# twice: as each container's environment (env_file) and, through
# --env-file, for ${VAR} interpolation in docker-compose.yaml (Grafana
# admin password, object storage S3 keys). Without --env-file .env.docker,
# compose stops with a "set ... in .env.docker" message.

# Application

# development | test | staging | production. Outside development/test
# the services refuse to start with a weak JWT_SECRET, an empty
# INTERNAL_API_TOKEN or an empty TOTP_ENCRYPTION_KEY.
APP_ENV=development

# Database

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alphamind

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# The services, Alembic, postgres-exporter and the backup scripts build
# the connection from the five values above. DATABASE_URL (async
# SQLAlchemy URL) overrides that for the services only, so leave it unset
# unless the services must reach a different server.

# Redis (REDIS_URL, when set, overrides host and port)

REDIS_HOST=redis
REDIS_PORT=6379


# Qdrant (QDRANT_URL, when set, overrides host and port)

QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Optional: only for a Qdrant server that requires an API key (sent as
# the `api-key` header by the scheduler's backup/restore scripts). Leave
# blank for the local Docker Qdrant.
QDRANT_API_KEY=

# Embeddings. The defaults are gemini-embedding-2, 1536 dims, collection
# research_documents_gemini. Set these together; for Mistral use
# EMBEDDING_PROVIDER=mistral, QDRANT_VECTOR_SIZE=1024 and a collection
# filled for it (`python -m scripts.reembed_collection`).
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_EMBEDDING_DIMENSIONS=1536
QDRANT_VECTOR_SIZE=1536
QDRANT_COLLECTION_RESEARCH=research_documents_gemini
# Near-duplicate cosine for archival notes (0.85 = code default,
# calibrated for gemini-embedding-2; use 0.90 with mistral-embed).
ARCHIVAL_NEAR_DUPLICATE_THRESHOLD=0.85

# Object storage (SeaweedFS in docker compose, service `objectstore` --
# point at a real AWS S3 or Cloudflare R2 endpoint in staging/production
# instead, no code change needed, see shared/storage.py).
# The compose service has the network name `minio`, so the endpoint
# below is http://minio:9000.
# In docker compose these two keys are also the only S3 identity of
# SeaweedFS (written into its S3 config at start by
# infra/objectstore/entrypoint.sh; no built-in default). They must not
# contain a newline or a tab.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=alphamind-dev
S3_SECRET_KEY=change-me-objectstore-secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_DOCUMENTS=research-documents

# JWT

# At least 32 random characters (e.g. `openssl rand -hex 32`); the
# placeholder is accepted only in development/test.
JWT_SECRET=CHANGE_ME

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=30

# Service-to-service authentication for every /internal/* endpoint
# (header X-Internal-Token). A long random string (e.g.
# `openssl rand -hex 32`), shared by all services and the scheduler.
# Empty is allowed only in development/test (with a warning).
INTERNAL_API_TOKEN=

# auth-service: Fernet key that encrypts the stored TOTP (2FA) secrets.
# Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside development/test; empty in development uses a key
# derived from JWT_SECRET (secrets written with it stay readable later).
TOTP_ENCRYPTION_KEY=

# Days of daily backups (infra/scheduler/backup.sh, ./backups on the
# host) to keep; see docs/DISASTER_RECOVERY.md.
BACKUP_RETENTION_DAYS=7

# auth-service: the nightly purge-unverified job deletes accounts that
# registered more than this many days ago, never verified their email,
# never signed in and have no OAuth link.
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7

# core-service: nightly auto-ingestion resubmits a document whose ingestion
# failed only while its first upload is newer than this many days
# (0 = never resubmit a failed document).
FAILED_DOCUMENT_RETRY_DAYS=7

# core-service: the nightly notification-retention job deletes READ
# notifications older than this many days (unread ones are kept).
NOTIFICATION_READ_RETENTION_DAYS=90

# core-service: safety brake of the nightly organization sweep. If auth
# reports more missing organizations than this count, or reports every
# organization core references as missing (more than one), the sweep
# deletes nothing and the job fails (a misconfigured or reset auth must
# not wipe all organization content). Raise it for one run to accept a
# large sweep. When every referenced organization is really gone, no
# value passes; clean them by hand (it asks auth first; preview, then
# --confirm):
#   docker compose exec core-service python -m scripts.clean_organizations --id <org id> --confirm
ORGANIZATION_SWEEP_MAX_MISSING=5

# OAuth login (auth-service). Leave blank to disable a provider.
# Register this callback URL with each provider:
#   https://localhost:8443/api/v1/auth/oauth/google/callback
#   https://localhost:8443/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL of the gateway (HTTPS, self-signed certificate in dev).
# Also Grafana's root URL (<this>/grafana/, set in docker-compose.yaml).
OAUTH_REDIRECT_BASE_URL=https://localhost:8443

# Frontend: where links in emails (verify email, reset password, accept
# an invitation) and the end of an OAuth sign-in (/oauth/complete) point.
# The frontend is served by the gateway; use http://localhost:3000 instead
# only while running `npm run dev`.
FRONTEND_BASE_URL=https://localhost:8443

# Email/SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@alphamind.local
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Monitoring
# Grafana admin password (user "admin"), REQUIRED: docker compose refuses
# to start without it. Grafana is at https://localhost:8443/grafana/.
GRAFANA_ADMIN_PASSWORD=
# Alert emails: the recipient is set in infra/alertmanager/alertmanager.yml
# (Alertmanager does not expand environment variables); in development the
# mail is caught by MailHog (http://127.0.0.1:8025).

# LLM providers (ai-service) -- the key of the provider in
# LLM_DEFAULT_PROVIDER is required to run analyses, and GOOGLE_API_KEY is
# also required whenever EMBEDDING_PROVIDER=google (the default), whatever
# the LLM provider; the others can stay blank. See
# services/ai-service/config.py for the tier -> model mapping per provider.
# GOOGLE_API_KEY_2 .. _10 are optional extra Google keys, pooled the same
# way as the Mistral ones below.
# LLM_DEFAULT_PROVIDER: google, mistral or anthropic. With anthropic the
# tiers use LLM_ANTHROPIC_MODEL_CHEAP (claude-haiku-5-5) and
# LLM_ANTHROPIC_MODEL_HIGHEST_ACCURACY (claude-sonnet-5-5), and embeddings
# stay on Google. The provider, the *_LLM_TIER settings and the Anthropic
# effort and thinking settings accept only their listed lower-case values:
# a blank value uses the default (a blank effort sends no effort), and any
# other value stops ai-service at startup. Optional Anthropic settings
# (defaults shown):
# LLM_ANTHROPIC_REQUEST_TIMEOUT_SECONDS=120
# LLM_ANTHROPIC_EFFORT=low
# LLM_ANTHROPIC_THINKING_CHEAP=adaptive
# LLM_ANTHROPIC_THINKING_HIGHEST_ACCURACY=between_tools
# LLM_ANTHROPIC_THINKING_HEADROOM_TOKENS=2048
# LLM_ANTHROPIC_SEND_TEMPERATURE=false
# LLM_ANTHROPIC_PROMPT_CACHING=true
# With caching on, false caches only the system prompt, not the ReAct
# scratchpad:
# LLM_ANTHROPIC_CACHE_SCRATCHPAD=true
# Experiment switch: true sends the evidence shared by Bull, Bear, Judge
# and Reflection as the first cached system block (handbook chapter 14):
# LLM_ANTHROPIC_SHARED_EVIDENCE_FIRST=false
# LLM_DEFAULT_PROVIDER=mistral
# LLM_DEFAULT_PROVIDER=anthropic
LLM_DEFAULT_PROVIDER=google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
GOOGLE_API_KEY_6=
GOOGLE_API_KEY_7=
GOOGLE_API_KEY_8=
GOOGLE_API_KEY_9=
GOOGLE_API_KEY_10=
MISTRAL_API_KEY=
# Optional: additional Mistral keys, pooled for higher throughput
# (round-robin across whichever of MISTRAL_API_KEY_2 .. _7 are set --
# leave them blank to use only MISTRAL_API_KEY, see
# ai/llm/mistral_provider.py).
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_API_KEY_4=
MISTRAL_API_KEY_5=
MISTRAL_API_KEY_6=
MISTRAL_API_KEY_7=

# External data providers (ai-service) -- all optional; agents degrade
# gracefully (thin evidence, not a crash) if a given one is unset.
# docs/handbook/13-ai-service.md section 3.6 lists what each one is used
# for.
SEC_EDGAR_USER_AGENT="Your Company Name AdminContact@yourdomain.com"
# Optional: LLM tier of the filing summary and filing records calls made
# when a new 10-K/10-Q is ingested: highest_accuracy (default) or cheap.
# FILING_LLM_TIER=highest_accuracy
FRED_API_KEY=
NEWSAPI_API_KEY=
TAVILY_API_KEY=
# edgartools' own request limit per second (read by the library, default 9).
# ai-service also paces its own SEC calls at 8/s; 2 keeps the two together
# within SEC's fair-access limit of 10 requests per second.
EDGAR_RATE_LIMIT_PER_SEC=2

# Logging

LOG_LEVEL=INFO

# CORS

BACKEND_CORS_ORIGINS=http://localhost:3000

# Optional tuning (the defaults below are the code defaults)

# ai-service RAG assistant (POST /api/v1/rag/ask and /ask/stream)
RAG_ASK_RATE_LIMIT_PER_MINUTE=10
RAG_ASK_RATE_LIMIT_PER_DAY=200
RAG_ASK_LLM_TIER=cheap
RAG_ASK_MAX_OUTPUT_TOKENS=1024
RAG_ASK_SNIPPET_CHARS=300
RAG_ASK_STREAM_TIMEOUT_SECONDS=120
# ai-service decision reviews (POST /api/v1/decisions/{id}/review), per user
DECISION_REVIEW_RATE_LIMIT_PER_MINUTE=3
DECISION_REVIEW_RATE_LIMIT_PER_DAY=20
# ai-service sentiment of notes and comments (POST /internal/sentiment)
SENTIMENT_MAX_INPUT_CHARS=6000
# ai-service experiment switch: true stops analyses from reading or writing
# prior-analysis context, episodic and procedural memory, archived notes and
# knowledge-graph facts (handbook chapter 16, section 3.2)
# ANALYSIS_EXPERIMENT_ISOLATION=false
# core-service collaborative notes: largest accepted Yjs update in bytes
YJS_MAX_UPDATE_BYTES=1048576
# All services: check each request against the live role/active state
# kept by auth-service (demotions and deactivations apply immediately)
USER_STATE_CHECK_ENABLED=true
USER_STATE_CACHE_TTL_SECONDS=300
# auth-service: friend requests one user may send per window
RATE_LIMIT_FRIEND_REQUESTS_PER_USER=30
RATE_LIMIT_FRIEND_REQUESTS_WINDOW_SECONDS=3600
