*.sqlite3

# Build

dist/

build/

# uv

uv.lock.bak

# Daily backups (infra/scheduler/backup.sh)
backups/

# Redis snapshots written by a redis-server started inside the repo
# (local testing), the output folders of run_analysis.sh (runs/; the
# top-level patterns cover the older per-ticker / batch run folders), and the local folder of Claude
# session outputs.
*.rdb
/runs/
/run_*/
/*_run_*/
/batch_run_*/
Claude outputs/
