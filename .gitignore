# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/

# macOS
.DS_Store

# Environment
# The real env file is `.env.docker` (not `.env`, which shared/config.py
# would load into local pytest runs). The tracked template is
# `.env.example` (copy it to `.env.docker`); the exception below must
# match that filename or the template stops being tracked.
.env
.env.*
!.env.example

# Docker-mount artifacts: empty, root-owned directories that appear under
# each service because docker-compose.override.yml mounts ./shared into
# ./services/<name>:/app as a nested bind mount. Never imported (the real
# `shared/` package lives only at the repo root).
services/auth-service/shared/
services/core-service/shared/
services/ai-service/shared/

# Runtime data
# Container logs written by the `vector` service, daily backups
# (infra/scheduler/backup.sh) and the output of scripts/run_analysis.sh.
*.log
/logs/
backups/
/runs/

# Locally generated TLS certificate for the gateway
# (infra/gateway/gen-certs.sh). Only the README is tracked.
infra/gateway/certs/*
!infra/gateway/certs/README.md

# RAG seed corpus: third-party documents (earnings calls, analyst
# reports, news), kept locally and never committed. See
# docs/handbook/17-ai-rag.md section 3.14.
/rag_seed_documents/
