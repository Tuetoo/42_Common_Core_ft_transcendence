# The gateway serves HTTPS with a self-signed certificate in development
# (infra/gateway/gen-certs.sh). `npm run dev` trusts it via
# NODE_EXTRA_CA_CERTS (see package.json); open https://localhost:8443 once
# in the browser and accept the certificate so wss:// connections work.
BACKEND_API_URL=https://localhost:8443/api/v1
NEXT_PUBLIC_WS_URL=wss://localhost:8443/ws
# The gateway's address as the browser sees it, for links and images the
# browser loads itself: OAuth sign-in buttons, uploaded avatars
# (/static/avatars/...). Leave empty when the frontend itself is served
# through the gateway (Docker), so those paths stay on the same origin.
NEXT_PUBLIC_GATEWAY_URL=https://localhost:8443
